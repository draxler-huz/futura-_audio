<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarm scheduling. Present since before Stage 0. Listed in ci/guards/allowed_permissions.txt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_idle_alarm"
        android:label="Wake-Up Music">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="true" />

        <!-- Stage 0 skeleton: Compose screen with the test tone and engine status. Reached from MainActivity. -->
        <activity
            android:name=".skeleton.SkeletonActivity"
            android:exported="false" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".PreflightReceiver"
            android:exported="false" />
    </application>
</manifest>
